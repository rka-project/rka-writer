{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/holistic-academic-reviewer/academic-session-envelope.schema.json",
  "title": "Holistic Academic Reviewer Session Envelope",
  "description": "A portable, index-only envelope for one native paper or NSF CISE proposal review run. It records provenance, hashes, native output roles, and a declared native-validator status linked to a report when completed. It intentionally contains no universal score, rating, recommendation, disposition, confidence, or assurance field; all judgment remains in the selected engine's native artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "created_at",
    "artifact_kind",
    "engine_id",
    "privacy_mode",
    "authority",
    "engine_manifest_sha256",
    "input_artifacts",
    "native_outputs",
    "native_validation",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "artifact_kind": {
      "enum": ["research_paper", "nsf_cise_proposal"]
    },
    "engine_id": {
      "enum": ["ai-cyber-paper-reviewer", "nsf-cise-mock-panelist"]
    },
    "privacy_mode": {
      "enum": [
        "local_only",
        "metadata_only_external_verification",
        "author_authorized_full_external_check"
      ]
    },
    "authority": {"$ref": "#/$defs/authority"},
    "engine_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/inputArtifact"}
    },
    "native_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nativeOutput"}
    },
    "native_validation": {"$ref": "#/$defs/nativeValidation"},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"artifact_kind": {"const": "research_paper"}},
        "required": ["artifact_kind"]
      },
      "then": {
        "properties": {
          "engine_id": {"const": "ai-cyber-paper-reviewer"},
          "authority": {
            "properties": {"profile": {"const": "venue_profile"}}
          },
          "native_outputs": {
            "items": {
              "properties": {
                "native_role": {"$ref": "#/$defs/paperNativeRole"}
              }
            }
          },
          "native_validation": {
            "properties": {
              "validator": {
                "const": "ai-cyber-paper-reviewer/scripts/validate_review.py"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"artifact_kind": {"const": "nsf_cise_proposal"}},
        "required": ["artifact_kind"]
      },
      "then": {
        "properties": {
          "engine_id": {"const": "nsf-cise-mock-panelist"},
          "authority": {
            "properties": {"profile": {"const": "nsf_solicitation_profile"}}
          },
          "native_outputs": {
            "items": {
              "properties": {
                "native_role": {"$ref": "#/$defs/nsfNativeRole"}
              }
            }
          },
          "native_validation": {
            "properties": {
              "validator": {
                "const": "nsf-cise-mock-panelist/scripts/validate_review.py"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F])(?!/)(?!~)(?!.*\\\\)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "status", "snapshot_output_id"],
      "properties": {
        "profile": {"enum": ["venue_profile", "nsf_solicitation_profile"]},
        "status": {"enum": ["verified", "provisional", "unknown"]},
        "snapshot_output_id": {
          "type": ["string", "null"],
          "pattern": "^O-[A-Za-z0-9._-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "verified"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "snapshot_output_id": {
                "type": "string",
                "pattern": "^O-[A-Za-z0-9._-]+$"
              }
            }
          }
        }
      ]
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "path",
        "sha256",
        "media_type",
        "inspection_status"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^A-[A-Za-z0-9._-]+$"
        },
        "role": {
          "enum": [
            "primary",
            "supplement",
            "appendix",
            "source",
            "authority",
            "supporting",
            "prior_review",
            "response",
            "other"
          ]
        },
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "inspection_status": {"enum": ["complete", "partial", "not_inspected"]}
      }
    },
    "nativeOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_id", "native_role", "path", "sha256", "media_type"],
      "properties": {
        "output_id": {
          "type": "string",
          "pattern": "^O-[A-Za-z0-9._-]+$"
        },
        "native_role": {
          "oneOf": [
            {"$ref": "#/$defs/paperNativeRole"},
            {"$ref": "#/$defs/nsfNativeRole"}
          ]
        },
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "paperNativeRole": {
      "enum": [
        "paper_venue_profile",
        "paper_review_bundle",
        "paper_referee_report",
        "paper_author_annex",
        "paper_validation_result"
      ]
    },
    "nsfNativeRole": {
      "enum": [
        "nsf_cise_packet_manifest",
        "nsf_cise_authority_snapshot",
        "nsf_cise_compliance_screen",
        "nsf_cise_individual_review",
        "nsf_cise_novelty_audit",
        "nsf_cise_methods_audit",
        "nsf_cise_broader_impacts_audit",
        "nsf_cise_presentation_audit",
        "nsf_cise_kill_argument",
        "nsf_cise_kill_adjudication",
        "nsf_cise_issue_ledger",
        "nsf_cise_pre_deliberation_validation",
        "nsf_cise_panel_aggregate",
        "nsf_cise_panel_summary",
        "nsf_cise_review_quality_audit",
        "nsf_cise_run_artifact_manifest",
        "nsf_cise_validation_report",
        "nsf_cise_revision_priorities"
      ]
    },
    "nativeValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validator",
        "validator_exit_code",
        "validated_at",
        "report_output_id"
      ],
      "properties": {
        "status": {"enum": ["passed", "failed", "not_run"]},
        "validator": {"$ref": "#/$defs/relativePath"},
        "validator_exit_code": {"type": ["integer", "null"]},
        "validated_at": {"type": ["string", "null"], "format": "date-time"},
        "report_output_id": {
          "type": ["string", "null"],
          "pattern": "^O-[A-Za-z0-9._-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "not_run"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "validator_exit_code": {"const": null},
              "validated_at": {"const": null},
              "report_output_id": {"const": null}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "passed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "validator_exit_code": {"const": 0},
              "validated_at": {"type": "string", "format": "date-time"},
              "report_output_id": {
                "type": "string",
                "pattern": "^O-[A-Za-z0-9._-]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "failed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "validator_exit_code": {"type": "integer", "not": {"const": 0}},
              "validated_at": {"type": "string", "format": "date-time"},
              "report_output_id": {
                "type": "string",
                "pattern": "^O-[A-Za-z0-9._-]+$"
              }
            }
          }
        }
      ]
    }
  }
}
