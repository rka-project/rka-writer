{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/nsf-cise-mock-panelist/panel-summary.schema.json",
  "title": "NSF CISE Mock Panel Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "reviewer_ids",
    "chair",
    "source_review_hashes",
    "synopsis",
    "mock_disposition",
    "panel_confidence",
    "overall_assessment",
    "intellectual_merit",
    "broader_impacts",
    "writing_and_accessibility",
    "technical_precision_integrity",
    "additional_criteria",
    "disagreements",
    "rating_changes",
    "chair_introduced_claims",
    "post_chair_verification",
    "conditions_that_would_change_assessment",
    "assurance_label",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "proposal_id": {"type": "string", "minLength": 1},
    "reviewer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "chair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "family", "route_id", "provenance_source", "family_basis"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "route_id": {"type": "string", "minLength": 1},
        "provenance_source": {"enum": ["runtime_metadata", "human_attestation", "self_reported", "unavailable"]},
        "family_basis": {"type": "string", "minLength": 1}
      }
    },
    "source_review_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "synopsis": {"type": "string", "minLength": 1},
    "mock_disposition": {"enum": ["highly_competitive", "competitive", "borderline", "not_competitive", "no_consensus", "unrated"]},
    "panel_confidence": {"enum": ["high", "medium", "low"]},
    "overall_assessment": {"type": "string", "minLength": 1},
    "intellectual_merit": {"$ref": "#/$defs/panelCriterion"},
    "broader_impacts": {"$ref": "#/$defs/panelCriterion"},
    "writing_and_accessibility": {"$ref": "#/$defs/panelCoverage"},
    "technical_precision_integrity": {"$ref": "#/$defs/panelCoverage"},
    "additional_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "source", "strength_finding_ids", "weakness_finding_ids"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "strength_finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "weakness_finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic_key", "kind", "topic", "positions", "evidence", "resolution", "minority_view"],
        "properties": {
          "topic_key": {"type": "string", "minLength": 1},
          "kind": {"enum": ["material_spread", "stance_conflict", "severity_spread", "chair_identified"]},
          "topic": {"type": "string", "minLength": 1},
          "positions": {"type": "object", "minProperties": 2},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "resolution": {"type": "string", "minLength": 1},
          "minority_view": {"type": "string", "minLength": 1}
        }
      }
    },
    "rating_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "initial", "revised", "trigger", "evidence", "rationale"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "initial": {"enum": ["excellent", "very_good", "good", "fair", "poor", "unrated"]},
          "revised": {"enum": ["excellent", "very_good", "good", "fair", "poor", "unrated"]},
          "trigger": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "chair_introduced_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "evidence", "verification_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verification_status": {"enum": ["verified", "qualified", "rejected", "unresolved"]}
        }
      }
    },
    "post_chair_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verifier", "notes"],
      "properties": {
        "status": {"enum": ["passed", "passed_with_qualifications", "failed", "not_run"]},
        "verifier": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "conditions_that_would_change_assessment": {"type": "array", "items": {"type": "string"}},
    "assurance_label": {"enum": ["provisional_advisory", "multi_family_advisory", "human_calibrated_advisory"]},
    "limitations": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "panelCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strength_finding_ids", "weakness_finding_ids"],
      "properties": {
        "strength_finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "weakness_finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "panelCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment", "synthesis", "strength_finding_ids", "weakness_finding_ids"],
      "properties": {
        "assessment": {"enum": ["strong", "adequate", "weak", "not_assessable"]},
        "synthesis": {"type": "string", "minLength": 1},
        "strength_finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "weakness_finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "anyOf": [
        {"properties": {"strength_finding_ids": {"minItems": 1}}},
        {"properties": {"weakness_finding_ids": {"minItems": 1}}}
      ]
    }
  }
}
