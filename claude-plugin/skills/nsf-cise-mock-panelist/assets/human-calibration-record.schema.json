{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/nsf-cise-mock-panelist/human-calibration-record.schema.json",
  "title": "NSF CISE Mock Panel Human Calibration Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "skill_profile",
    "evaluated_on",
    "calibration_set",
    "human_anchors",
    "metrics",
    "thresholds",
    "result",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "skill_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "protocol_bundle_sha256", "model_families", "model_ids", "route_topology"],
      "properties": {
        "name": {"const": "nsf-cise-mock-panelist"},
        "protocol_bundle_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "model_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "model_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "route_topology": {"const": "three_independent_reviewers_plus_fresh_chair"}
      }
    },
    "evaluated_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "calibration_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "deidentified", "held_out", "sample_size"],
      "properties": {
        "authorized": {"const": true},
        "deidentified": {"const": true},
        "held_out": {"const": true},
        "sample_size": {"type": "integer", "minimum": 1}
      }
    },
    "human_anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "qualification_basis", "independent_from_generation"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "qualification_basis": {"type": "string", "minLength": 1},
        "independent_from_generation": {"const": true}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_coverage",
        "finding_precision",
        "finding_recall",
        "evidence_anchor_accuracy",
        "rating_weighted_kappa",
        "repeated_run_stability"
      ],
      "properties": {
        "criterion_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "finding_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "finding_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_anchor_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "rating_weighted_kappa": {"type": "number", "minimum": -1, "maximum": 1},
        "repeated_run_stability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_coverage",
        "finding_precision",
        "finding_recall",
        "evidence_anchor_accuracy",
        "rating_weighted_kappa",
        "repeated_run_stability"
      ],
      "properties": {
        "criterion_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "finding_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "finding_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_anchor_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "rating_weighted_kappa": {"type": "number", "minimum": -1, "maximum": 1},
        "repeated_run_stability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "thresholds_version", "attested_by", "notes"],
      "properties": {
        "status": {"enum": ["passed", "failed", "inconclusive"]},
        "thresholds_version": {"type": "string", "minLength": 1},
        "attested_by": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"type": "string", "minLength": 1}
  }
}
